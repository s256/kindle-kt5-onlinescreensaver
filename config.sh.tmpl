# ha-dashboard configuration overrides
#
# Copy this file alongside ha-dashboard.sh and edit the values below.
# Any variable set here overrides the defaults in ha-dashboard.sh.

# URL of the dashboard image (must be 600x800 PNG for Kindle Touch D01200)
IMAGE_URL="http://localhost:8080/"

# Seconds between refreshes
REFRESH_INTERVAL=120

# RTC device (1 = pmic_rtc, the only RTC that can wake D01200 from suspend)
RTC=1

# Disable WiFi between refreshes to save battery (1=yes, 0=no)
DISABLE_WIFI=1

# Seconds to wait for WiFi to connect
WIFI_TIMEOUT=30

# Host to ping to verify connectivity (use your router or HA server IP)
PING_HOST="192.168.1.1"

# Battery level at which to stop refreshing
BATTERY_CRITICAL=2

# Kindle screensaver folder and file (image is copied here so the native
# screensaver shows our dashboard instead of the default sleep screen)
SCREENSAVER_DIR="/mnt/us/linkss/screensavers"
SCREENSAVER_FILE="bg_xsmall_ss00.png"

# Seconds to stay awake after displaying the image before suspending.
# Keeps WiFi up so you can SSH in. Increase if you need more time.
AWAKE_DELAY=120
